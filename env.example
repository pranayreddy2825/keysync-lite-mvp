# KeySync Lite Environment Variables
# Copy this file to .env and fill in your API credentials

# Google Gemini API Key
# Get from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database
# Your Qdrant instance URL
QDRANT_URL=https://your-qdrant-instance.us-west-1-0.aws.cloud.qdrant.io

# Qdrant API Key
# Your Qdrant API authentication key
QDRANT_API_KEY=your_qdrant_api_key_here
